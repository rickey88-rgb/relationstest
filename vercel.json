{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/verified-conversion-tracking-main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/audhd-checkout-cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/account-analysis-cleanup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/test-account-cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/stripe-measurement",
      "schedule": "*/15 * * * *"
    }
  ]
}
