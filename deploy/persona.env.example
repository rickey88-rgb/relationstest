# PERSONA only. Merge into reviewed configuration; do not replace existing values.
# Default closed. Turn on only after the release checklist is signed off.
TEST_ACCOUNTS_PERSONA_ENABLED=false
TEST_ACCOUNTS_PERSONA_CHECKOUT_ENABLED=false
TEST_ACCOUNTS_PERSONA_SAVE_ENABLED=false
TEST_ACCOUNTS_PERSONA_READ_ENABLED=false
TEST_ACCOUNTS_PERSONA_PRICE_ID=price_REPLACE_WITH_REVIEWED_PERSONA_PRICE
# Add persona_test.priceIds to the EXISTING STRIPE_PAYMENT_PRODUCT_MAP_JSON.
# Retain every existing product and historical Price ID. No Payment Links.
# Use merge-persona-map.cjs for a reviewable merged JSON file; it changes no service.
# Existing direct-customer/account/storage/journal/TLS/cleanup/Auth settings remain required.
# NEXT_PUBLIC_DIRECT_TEST_ACCOUNTS_ENABLED must already be enabled in the frontend build.
# DIRECT_CUSTOMER_TESTS_ENABLED, ACCOUNT_PORTAL_ENABLED and direct Mina sidor must be active.
# Do not insert live keys into a local test environment. Offline tests use tests/persona/isolated.config.json.
